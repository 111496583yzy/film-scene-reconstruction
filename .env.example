# OPTIONAL external video analysis. This template contains no credentials.
# Put your real configuration OUTSIDE this repository, in a file with mode 0600.
# Base URL/model must come from your chosen provider, not from a hardcoded default.
FILM_ANALYSIS_PROVIDER=
FILM_ANALYSIS_API_BASE_URL=
FILM_ANALYSIS_MODEL=
FILM_ANALYSIS_API_KEY=
FILM_ANALYSIS_PROTOCOL=gemini_generate_content
FILM_ANALYSIS_REQUEST_PATH=/v1beta/models/{model}:generateContent
FILM_ANALYSIS_AUTH_HEADER=Authorization
FILM_ANALYSIS_AUTH_SCHEME=Bearer

# Operator-defined limits, NOT promises about provider/model capabilities.
FILM_ANALYSIS_MAX_REQUEST_BYTES=20000000
FILM_ANALYSIS_MAX_OUTPUT_TOKENS=6000
FILM_ANALYSIS_TIMEOUT_SECONDS=180
FILM_ANALYSIS_VIDEO_FPS=4
